#!/bin/bash

# Конфигурационные параметры
BIN_PATH="/usr/local/bin/ax-xray"
CONFIG_DIR="/usr/local/etc/xray"
CONFIG_FILE="$CONFIG_DIR/config.json"
KEYS_FILE="$CONFIG_DIR/.keys"

# Функция установки Xray
install_xray() {
    echo "Установка Xray-core и настройка системы..."

    # Обновление системы
    apt update
    apt install -y qrencode curl jq

    # Включение BBR
    if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf; then
        echo "Включение оптимизации BBR..."
        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
        sysctl -p
    fi

    # Установка Xray
    echo "Установка Xray-core..."
    bash -c "$(curl -4 -sL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install

    # Создание директории конфигурации
    mkdir -p "$CONFIG_DIR"

    # Генерация ключей
    echo "Генерация криптографических ключей..."
    [ -f "$KEYS_FILE" ] && rm "$KEYS_FILE"
    touch "$KEYS_FILE"
    echo "uuid: $(xray uuid)" >> "$KEYS_FILE"
    xray x25519 >> "$KEYS_FILE"
    echo "shortsid: $(openssl rand -hex 8)" >> "$KEYS_FILE"

    # Загрузка ключей
    uuid=$(awk -F': ' '/uuid/{print $2}' "$KEYS_FILE")
    privatkey=$(awk -F': ' '/Private key/{print $2}' "$KEYS_FILE")
    shortsid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")

    # Создание конфигурации
    cat << EOF > "$CONFIG_FILE"
{
    "log": {"loglevel": "warning"},
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {"type": "field", "domain": ["geosite:category-ads-all"], "outboundTag": "block"},
            {"type": "field", "ip": ["geoip:cn"], "outboundTag": "block"}
        ]
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [{"username": "main", "id": "$uuid", "flow": "xtls-rprx-vision"}],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "cloudflare.com:443",
                    "xver": 0,
                    "serverNames": ["cloudflare.com", "www.cloudflare.com"],
                    "privateKey": "$privatkey",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": ["$shortsid"]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls"]
            }
        }
    ],
    "outbounds": [
        {"protocol": "freedom", "tag": "direct"},
        {"protocol": "blackhole", "tag": "block"}
    ],
    "policy": {
        "levels": {"0": {"handshake": 3, "connIdle": 180}}
    }
}
EOF

    # Перезапуск Xray
    systemctl restart xray
    echo "Xray-core успешно установлен и запущен!"
}

# Функция создания управляющей утилиты
create_ax_xray() {
    echo "Создание управляющей утилиты ax-xray..."

    cat << 'EOF' > "$BIN_PATH"
#!/bin/bash

# Конфигурационные параметры
CONFIG_DIR="/usr/local/etc/xray"
CONFIG_FILE="$CONFIG_DIR/config.json"
KEYS_FILE="$CONFIG_DIR/.keys"

# Функция генерации ссылки
generate_link() {
    local protocol=$1 uuid=$2 ip=$3 port=$4 sni=$5 pbk=$6 sid=$7 username=$8
    link="$protocol://$uuid@$ip:$port?security=reality&sni=$sni&fp=firefox&pbk=$pbk&sid=$sid&spx=/&type=tcp&flow=xtls-rprx-vision&encryption=none#$username"

    echo -e "\nСсылка для $username:"
    echo "$link"
    echo -e "\nQR-код:"
    echo "$link" | qrencode -t ansiutf8
}

# Основной пользователь
main_user() {
    [ -f "$KEYS_FILE" ] || { echo "Файл ключей не найден"; exit 1; }

    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    uuid=$(awk -F': ' '/uuid/{print $2}' "$KEYS_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid" "$ip" "$port" "$sni" "$pbk" "$sid" "main"
}

# Добавление пользователя
add_user() {
    [ -f "$CONFIG_FILE" ] || { echo "Конфигурация не найдена"; exit 1; }

    read -p "Введите username пользователя: " username
    [[ -z "$username" || "$username" =~ [[:space:]] ]] && { echo "Некорректный username"; exit 1; }

    # Проверка существования
    if jq -e --arg username "$username" '.inbounds[0].settings.clients[] | select(.username == $username)' "$CONFIG_FILE" >/dev/null; then
        echo "Пользователь $username уже существует!"
        exit 1
    fi

    # Добавление пользователя
    uuid_new=$(xray uuid)
    jq --arg username "$username" --arg uuid "$uuid_new" \
        '.inbounds[0].settings.clients += [{"username": $username, "id": $uuid, "flow": "xtls-rprx-vision"}]' \
        "$CONFIG_FILE" > tmp.json && mv tmp.json "$CONFIG_FILE"

    systemctl restart xray
    echo "Пользователь $username успешно добавлен!"

    # Генерация ссылки
    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid_new" "$ip" "$port" "$sni" "$pbk" "$sid" "$username"
}

# Удаление пользователя
remove_user() {
    [ -f "$CONFIG_FILE" ] || { echo "Конфигурация не найдена"; exit 1; }

    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [ ${#usernames[@]} -eq 0 ] && { echo "Нет пользователей"; exit 1; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do echo "$((i+1)). ${usernames[i]}"; done

    read -p "Выберите номер для удаления: " num
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#usernames[@]} ]] && { echo "Некорректный выбор"; exit 1; }

    username=${usernames[$((num-1))]}
    jq --arg username "$username" \
        'del(.inbounds[0].settings.clients[] | select(.username == $username))' \
        "$CONFIG_FILE" > tmp.json && mv tmp.json "$CONFIG_FILE"

    systemctl restart xray
    echo "Пользователь $username удалён!"
}

# Генерация ссылки пользователя
generate_user() {
    [ -f "$CONFIG_FILE" ] || { echo "Конфигурация не найдена"; exit 1; }

    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [ ${#usernames[@]} -eq 0 ] && { echo "Нет пользователей"; exit 1; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do echo "$((i+1)). ${usernames[i]}"; done

    read -p "Выберите пользователя: " num
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#usernames[@]} ]] && { echo "Некорректный выбор"; exit 1; }

    username=${usernames[$((num-1))]}
    user_data=$(jq --arg username "$username" '.inbounds[0].settings.clients[] | select(.username == $username)' "$CONFIG_FILE")
    uuid=$(jq -r '.id' <<< "$user_data")

    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid" "$ip" "$port" "$sni" "$pbk" "$sid" "$username"
}

# Список пользователей
list_users() {
    [ -f "$CONFIG_FILE" ] || { echo "Конфигурация не найдена"; exit 1; }

    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [ ${#usernames[@]} -eq 0 ] && { echo "Нет пользователей"; exit 0; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do echo "$((i+1)). ${usernames[i]}"; done
}

# Статус сервиса
service_status() {
    systemctl status xray --no-pager
}

# Перезапуск сервиса
restart_service() {
    systemctl restart xray
    echo "Сервис Xray перезапущен"
}

# Просмотр логов
view_logs() {
    journalctl -u xray -n 50 --no-pager
}

# Помощь
show_help() {
    echo "Использование: ax-xray [КОМАНДА]"
    echo
    echo "Команды:"
    echo "  install         - Первоначальная установка Xray"
    echo "  main            - Ссылка основного пользователя"
    echo "  add             - Добавить пользователя"
    echo "  remove          - Удалить пользователя"
    echo "  generate        - Сгенерировать ссылку для пользователя"
    echo "  list            - Список пользователей"
    echo "  status          - Статус сервиса Xray"
    echo "  restart         - Перезапустить Xray"
    echo "  logs            - Просмотр логов"
    echo "  help            - Показать эту справку"
    echo
    echo "Примеры:"
    echo "  ax-xray install   # Установка сервера"
    echo "  ax-xray add       # Добавить нового пользователя"
    echo "  ax-xray main      # Получить ссылку основного пользователя"
}

# Проверка прав
check_root() {
    [ "$(id -u)" -ne 0 ] && { 
        echo "Эта команда требует прав root. Используйте sudo."
        exit 1
    }
}

# Основной код утилиты
case "$1" in
    install)
        check_root
        echo "Установка Xray-core..."
        # Вызов функции установки из внешнего скрипта
        /usr/local/bin/ax-xray-installer install
        ;;
    main)
        main_user
        ;;
    add)
        check_root
        add_user
        ;;
    remove)
        check_root
        remove_user
        ;;
    generate)
        generate_user
        ;;
    list)
        list_users
        ;;
    status)
        service_status
        ;;
    restart)
        check_root
        restart_service
        ;;
    logs)
        view_logs
        ;;
    help|--help|-h|*)
        show_help
        ;;
esac
EOF

    # Делаем утилиту исполняемой
    chmod +x "$BIN_PATH"
    echo "Утилита ax-xray успешно создана в $BIN_PATH"
    echo "Для использования: ax-xray [команда]"
}

# Главная функция установщика
main_installer() {
    # Установка Xray
    install_xray

    # Создание управляющей утилиты
    create_ax_xray

    # Создаем отдельный установщик для поддержки обновлений
    cat << 'EOF' > /usr/local/bin/ax-xray-installer
#!/bin/bash
# Внутренний установщик для поддержки обновлений
[ "$1" = "install" ] && {
    # Код функции install_xray из основного скрипта
    # ... (полный код функции install_xray)
}
EOF
    cat <(declare -f install_xray) <(echo 'install_xray "$@"') > /usr/local/bin/ax-xray-installer
    chmod +x /usr/local/bin/ax-xray-installer

    echo "Установка завершена!"
    echo "Используйте 'ax-xray help' для просмотра команд управления"
}

# Проверка прав root
[ "$(id -u)" -ne 0 ] && {
    echo "Скрипт требует запуска с правами root. Используйте sudo."
    exit 1
}

# Запуск установки
main_installer
