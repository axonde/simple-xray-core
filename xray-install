#!/bin/bash

# Конфигурационные пути
CONFIG_FILE="/usr/local/etc/xray/config.json"
KEYS_FILE="/usr/local/etc/xray/.keys"

# Основная функция установки
install_xray() {
    echo "Начало установки Xray-core..."
    apt update
    apt install qrencode curl jq -y -q

    # Включаем BBR
    if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf; then
        echo "Включение BBR..."
        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
        sysctl -p
    else
        echo "BBR уже включен"
    fi

    # Установка Xray-core
    echo "Установка Xray-core..."
    bash -c "$(curl -4 -sL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install

    # Генерация ключей
    [ -f "$KEYS_FILE" ] && rm "$KEYS_FILE"
    touch "$KEYS_FILE"
    echo "uuid: $(xray uuid)" >> "$KEYS_FILE"
    xray x25519 >> "$KEYS_FILE"
    echo "shortsid: $(openssl rand -hex 8)" >> "$KEYS_FILE"

    # Загрузка ключей в переменные
    uuid=$(awk -F': ' '/uuid/{print $2}' "$KEYS_FILE")
    privatkey=$(awk -F': ' '/Private key/{print $2}' "$KEYS_FILE")
    shortsid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")

    # Создание конфигурации
    cat << EOF > "$CONFIG_FILE"
{
    "log": {"loglevel": "warning"},
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {"type": "field", "domain": ["geosite:category-ads-all"], "outboundTag": "block"},
            {"type": "field", "ip": ["geoip:cn"], "outboundTag": "block"}
        ]
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [{"username": "main", "id": "$uuid", "flow": "xtls-rprx-vision"}],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "github.com:443",
                    "xver": 0,
                    "serverNames": ["github.com", "www.github.com"],
                    "privateKey": "$privatkey",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": ["$shortsid"]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls"]
            }
        }
    ],
    "outbounds": [
        {"protocol": "freedom", "tag": "direct"},
        {"protocol": "blackhole", "tag": "block"}
    ],
    "policy": {
        "levels": {"0": {"handshake": 3, "connIdle": 180}}
    }
}
EOF

    systemctl restart xray
    echo "Xray-core успешно установлен и запущен!"
}

# Функция для получения ссылки основного пользователя
main_user() {
    [ ! -f "$KEYS_FILE" ] && { echo "Ошибка: файл ключей не найден"; exit 1; }

    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    uuid=$(awk -F': ' '/uuid/{print $2}' "$KEYS_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid" "$ip" "$port" "$sni" "$pbk" "$sid" "main"
}

# Функция генерации ссылки
generate_link() {
    local protocol=$1 uuid=$2 ip=$3 port=$4 sni=$5 pbk=$6 sid=$7 username=$8
    link="$protocol://$uuid@$ip:$port?security=reality&sni=$sni&fp=firefox&pbk=$pbk&sid=$sid&spx=/&type=tcp&flow=xtls-rprx-vision&encryption=none#$username"

    echo -e "\nСсылка для $username:"
    echo "$link"
    echo -e "\nQR-код:"
    echo "$link" | qrencode -t ansiutf8
}

# Функция добавления пользователя
add_user() {
    [ ! -f "$CONFIG_FILE" ] && { echo "Ошибка: конфиг Xray не найден"; exit 1; }

    read -p "Введите ник пользователя: " username
    [[ -z "$username" || "$username" =~ [[:space:]] ]] && { echo "Некорректный ник (не должно быть пробелов)"; exit 1; }

    # Проверка существования пользователя
    if jq -e --arg username "$username" '.inbounds[0].settings.clients[] | select(.username == $username)' "$CONFIG_FILE" >/dev/null; then
        echo "Пользователь уже существует!"
        exit 1
    fi

    # Добавление пользователя
    uuid_new=$(xray uuid)
    jq --arg username "$username" --arg uuid "$uuid_new" \
        '.inbounds[0].settings.clients += [{"username": $username, "id": $uuid, "flow": "xtls-rprx-vision"}]' \
        "$CONFIG_FILE" > tmp.json && mv tmp.json "$CONFIG_FILE"

    systemctl restart xray
    echo "Пользователь $username успешно добавлен!"

    # Генерация ссылки для нового пользователя
    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid_new" "$ip" "$port" "$sni" "$pbk" "$sid" "$username"
}

# Функция удаления пользователя
remove_user() {
    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [[ ${#usernames[@]} -eq 0 ]] && { echo "Нет пользователей"; exit 1; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do
        echo "$((i+1)). ${usernames[i]}"
    done

    read -p "Выберите номер для удаления: " num
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#usernames[@]} ]] && { echo "Некорректный выбор"; exit 1; }

    username=${usernames[$((num-1))]}
    jq --arg username "$username" \
        'del(.inbounds[0].settings.clients[] | select(.username == $username))' \
        "$CONFIG_FILE" > tmp.json && mv tmp.json "$CONFIG_FILE"

    systemctl restart xray
    echo "Пользователь $username удалён!"
}

# Функция генерации ссылки для выбранного пользователя
generate_user_link() {
    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [[ ${#usernames[@]} -eq 0 ]] && { echo "Нет пользователей"; exit 1; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do
        echo "$((i+1)). ${usernames[i]}"
    done

    read -p "Выберите пользователя: " num
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#usernames[@]} ]] && { echo "Некорректный выбор"; exit 1; }

    username=${usernames[$((num-1))]}
    user_data=$(jq --arg username "$usernamee" '.inbounds[0].settings.clients[] | select(.username == $username)' "$CONFIG_FILE")
    uuid=$(jq -r '.id' <<< "$user_data")

    protocol=$(jq -r '.inbounds[0].protocol' "$CONFIG_FILE")
    port=$(jq -r '.inbounds[0].port' "$CONFIG_FILE")
    pbk=$(awk -F': ' '/Public key/{print $2}' "$KEYS_FILE")
    sid=$(awk -F': ' '/shortsid/{print $2}' "$KEYS_FILE")
    sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    ip=$(curl -4 -s icanhazip.com || echo "ВАШ_IP")

    generate_link "$protocol" "$uuid" "$ip" "$port" "$sni" "$pbk" "$sid" "$username"
}

# Функция списка пользователей
list_users() {
    usernames=($(jq -r '.inbounds[0].settings.clients[].username' "$CONFIG_FILE"))
    [[ ${#usernames[@]} -eq 0 ]] && { echo "Нет пользователей"; exit 0; }

    echo "Список пользователей:"
    for i in "${!usernames[@]}"; do
        echo "$((i+1)). ${usernames[i]}"
    done
}

# Функция справки
show_help() {
    echo "Использование: $0 [ФЛАГ]"
    echo "Флаги:"
    echo "  -i, --install    : Установка Xray-core"
    echo "  -m, --main       : Ссылка основного пользователя"
    echo "  -a, --add        : Добавить нового пользователя"
    echo "  -r, --remove     : Удалить пользователя"
    echo "  -g, --generate   : Сгенерировать ссылку для пользователя"
    echo "  -l, --list       : Список пользователей"
    echo "  -h, --help       : Показать эту справку"
    echo ""
    echo "Управление сервисом: systemctl restart|status xray"
    echo "Конфиг: $CONFIG_FILE"
}

# Парсинг аргументов
case "$1" in
    -i|--install) install_xray ;;
    -m|--main) main_user ;;
    -a|--add) add_user ;;
    -r|--remove) remove_user ;;
    -g|--generate) generate_user_link ;;
    -l|--list) list_users ;;
    -h|--help|*) show_help ;;
esac
